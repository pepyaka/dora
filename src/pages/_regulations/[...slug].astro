---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import { type CollectionEntry, getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("regulations");
  return entries.map((entry: CollectionEntry<"regulations">) => ({
    params: { slug: decodeURI(entry.id) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"regulations">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { editUrl, hero, ...frontmatter } = entry.data;
---

<StarlightPage frontmatter={frontmatter} headings={headings}>
  <Content />
</StarlightPage>
